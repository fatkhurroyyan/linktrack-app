# LinkSense AI (LinkTrack-App) Environment Configuration

# Google Gemini API Key (Required for AI Reasoning & Summaries)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Optional: Google Drive API Key (for deeper folder traversal of public folders)
GOOGLE_DRIVE_API_KEY=

# Optional: GitHub Personal Access Token (for higher rate limits on GitHub API)
GITHUB_TOKEN=

# Database Configuration
# 1. Local SQLite (Default):
DATABASE_URL=sqlite+aiosqlite:///./linktrack.db
# 2. Supabase Cloud PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
