.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# SQLite & Local Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/linktrack.db*

# 3. Node & Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
